        <mxCell id="lMvSMg3vNdxG5hSPP2Z_-315" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font face=&quot;Lucida Console&quot; style=&quot;font-size: 150px;&quot;&gt;Release Proccess&lt;/font&gt;" vertex="1">
